function Start-Run([bool]$dry) {
    $sel = @($tasks | Where-Object { $_.Box.Checked })
    if ($dry) { $sel = @($sel | Where-Object { $previewKeys -contains $_.Key }) }
    if ($sel.Count -eq 0) {
        $m = L 'm_select'
        if ($dry) { $m = L 'm_prev_sel' }
        [void](Msg $m)
        return
    }
    $keys = @($sel | ForEach-Object { $_.Key })
    $needsRP = (-not $dry) -and $cbRestore.Checked -and (@($keys | Where-Object { $readOnlyKeys -notcontains $_ }).Count -gt 0)

    # Disk type (SSD / HDD) drives the time estimates - detected once
    if (-not $global:diskType) { Pump; $global:diskType = Get-DiskType }
    if (-not $dry -and ($keys -contains 'logs') -and -not $global:scan.ContainsKey('logcount')) {
        try { $global:scan['logcount'] = @(& wevtutil.exe el).Count } catch {}
    }
    Update-Estimates

    $lo = 0.0; $hi = 0.0; $lines = @(); $warn = @()
    foreach ($t in $sel) {
        $e = Get-Estimate $t.Key
        $lo += $e.Lo; $hi += $e.Hi
        $lines += ('  - {0}: {1}' -f (L ('t_' + $t.Key)), $e.Detail)
        $wk = 'wn_' + $t.Key
        if (-not $dry -and $LangTable['en'].ContainsKey($wk)) { $warn += (L $wk) }
    }
    if ($needsRP) { $lo += 30; $hi += 90; $lines += ('  - ' + (L 'est_restore_line')) }
    $range = Fmt-Range $lo $hi

    # One confirmation with the estimate, what each task does and the warnings
    if (-not $dry) {
        $msg = ((L 'm_est') -f $range) + "`n`n" + ($lines -join "`n")
        if ($warn.Count -gt 0) { $msg += "`n`n" + ($warn -join "`n") }
        $msg += "`n`n" + (L 'm_continue')
        $icon = 'Question'
        if ($warn.Count -gt 0) { $icon = 'Warning' }
        if ((Msg $msg 'YesNo' $icon) -ne 'Yes') { return }
    }

    $global:dry = $dry
    if ($dry) { $global:previewTotal = [long]0; $global:scanRows.Clear() }
    Update-FreedLabel
    $global:cancel = $false
    $global:needRestart = $false
    Set-Busy $true
    $total = $sel.Count; $i = 0; $restartChk = $false
    $global:total = $total; $global:idx = 0
    $global:subBase = 0.0; $global:subScale = 1.0
    $runWord = 'w_running'
    if ($dry) { $runWord = 'w_scan' }
    Set-Progress 0 $runWord
    $start = Get-Date
    if ($dry) { Log ("=== Preview started {0}  (nothing will be deleted) ===" -f $start.ToString('yyyy-MM-dd HH:mm:ss')) 'Orange' }
    else      { Log ("=== Started {0} ===" -f $start.ToString('yyyy-MM-dd HH:mm:ss')) 'Orange' }
    Log ("Estimated time: {0}" -f $range) 'Gray'

    if ($needsRP) {
        $lblStatus.Text = L 's_restore'
        Set-Progress 0 'w_restore'
        Log "`r`n[0] System Restore point" 'Orange'
        try { Task-Restore } catch { Log ("  Restore point error: " + $_.Exception.Message) 'Gold' }
        Set-Progress 0 $runWord
    }

    foreach ($t in $sel) {
        if ($global:cancel) { break }
        $i++
        $global:idx = $i; $global:step = $t.Short; $global:curKey = $t.Key
        $title = L ('t_' + $t.Key)
        $lblStatus.Text = "[$i/$total] $title"
        Log "`r`n[$i/$total] $title" 'Orange'
        try {
            switch ($t.Key) {
                'clean'   { Task-Clean }
                'deep'    { Task-Deep }
                'web'     { Task-Browsers }
                'logs'    { Task-Logs }
                'winold'  { Task-WinOld }
                'hiber'   { Task-Hiber }
                'dism'    { Task-Dism }
                'sfc'     { Task-Sfc }
                'wu'      { Task-WU }
                'net'     { Task-Net }
                'store'   { Task-Store }
                'chk'     { Task-Chk; $restartChk = $true }
                'space'   { Task-Space }
                'startup' { Task-Startup }
                'smart'   { Task-Smart }
            }
        } catch {
            Log ("  Error: " + $_.Exception.Message) 'Tomato'
        }
        Set-Progress ([int](100 * $i / $total)) $runWord
    }

    $dur = (Get-Date) - $start
    if ($global:cancel) {
        Log (("`r`n=== Cancelled after {0:mm\:ss} ===" -f $dur)) 'Gold'
        $lblStatus.Text = L 's_cancelled'
        Set-Progress $global:pct 'w_cancel'
    } elseif ($dry) {
        # remember what the preview found, so the cards can show real sizes and better time estimates
        foreach ($k in @('clean', 'deep', 'web', 'winold', 'hiber')) {
            if ($keys -contains $k) {
                [long]$b = 0; [long]$f = 0
                foreach ($r in $global:scanRows) { if ($r.Key -eq $k) { $b += $r.Bytes; $f += $r.Files } }
                $global:scan[$k] = @{ Bytes = $b; Files = $f }
            }
        }
        Log '' 'Gray'
        Show-ScanSummary
        Log (("=== Preview finished. Nothing was deleted. Press Run selected to clean. ===")) 'LimeGreen'
        $lblStatus.Text = (L 's_prev_done') -f (Fmt-Size $global:previewTotal)
        Set-Progress 100 'w_preview'
    } else {
        Log (("`r`n=== All tasks completed in {0:mm\:ss}  |  Total freed: {1}  |  $($global:Developer) ===" -f $dur, (Fmt-Size $global:freedTotal))) 'LimeGreen'
        $lblStatus.Text = L 's_done'
        Set-Progress 100 'w_done'
    }

    if (-not $dry) {
        try {
            $f = Join-Path $env:RS_DIR ("RFX_Log_{0}.txt" -f (Get-Date -Format 'yyyyMMdd_HHmmss'))
            Set-Content -LiteralPath $f -Value $log.Text -Encoding UTF8 -ErrorAction Stop
            Log "Log saved: $f" 'Gray'
        } catch {}
        # old preview numbers are stale after a clean
        foreach ($k in $keys) { if ($global:scan.ContainsKey($k) -and $k -ne 'logs') { $global:scan.Remove($k) } }
    }

    $global:dry = $false
    Set-Busy $false
    Update-Estimates
    Update-Info

    if (($restartChk -or $global:needRestart) -and -not $global:cancel -and -not $dry) {
        $r = Msg (L 'm_restart') 'YesNo' 'Question'
        if ($r -eq 'Yes') { & shutdown.exe /r /t 15 /c 'Reach Studio: restarting to finish repairs' }
    }
}

$btnRun.Add_Click({ Start-Run $false })
$btnPreview.Add_Click({ Start-Run $true })

