# 0) System Restore point (runs first, before any change)
function Task-Restore {
    Log '  Creating a System Restore point (can take up to a minute)...' 'White'
    $sr = 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\SystemRestore'
    $old = $null
    try { $old = (Get-ItemProperty -Path $sr -Name SystemRestorePointCreationFrequency -ErrorAction Stop).SystemRestorePointCreationFrequency } catch {}
    # Windows normally allows only 1 restore point per 24h; lift that limit for this call
    try { Set-ItemProperty -Path $sr -Name SystemRestorePointCreationFrequency -Value 0 -Type DWord -ErrorAction Stop } catch {}
    $inner = @'
$ErrorActionPreference = 'Stop'
try { Enable-ComputerRestore -Drive "$env:SystemDrive\" } catch {}
Checkpoint-Computer -Description 'RFX by Reach - before cleanup' -RestorePointType MODIFY_SETTINGS
'@
    $code = Run-PS $inner
    try {
        if ($null -ne $old) { Set-ItemProperty -Path $sr -Name SystemRestorePointCreationFrequency -Value $old -Type DWord -ErrorAction Stop }
        else { Remove-ItemProperty -Path $sr -Name SystemRestorePointCreationFrequency -ErrorAction SilentlyContinue }
    } catch {}
    if ($global:cancel) { return }
    if ($code -eq 0) { Log '  Restore point created: "RFX by Reach - before cleanup"' 'LimeGreen' }
    else { Log '  Could not create a restore point (System Protection may be blocked by policy). Continuing.' 'Gold' }
}

# 4) Event logs
function Task-Logs {
    $names = @(& wevtutil.exe el)
    $global:scan['logcount'] = $names.Count
    if ($global:dry) {
        Log ("  Event logs found: {0}  (preview - nothing cleared)" -f $names.Count) 'Gainsboro'
        return
    }
    $i = 0; $ok = 0
    foreach ($n in $names) {
        if ($global:cancel) { break }
        & wevtutil.exe cl "$n" 2>&1 | Out-Null
        if ($LASTEXITCODE -eq 0) { $ok++ }
        $i++
        if (($i % 20) -eq 0) { Set-Sub (100.0 * $i / [Math]::Max(1, $names.Count)); Pump }
    }
    Log "  Cleared $ok of $($names.Count) event logs." 'LimeGreen'
}

# 5) DISM: repair image, then clean the component store (safe - no /ResetBase)
function Task-Dism {
    $global:subBase = 0.0; $global:subScale = 0.80
    [void](Run-External 'DISM.exe /Online /Cleanup-Image /RestoreHealth')
    if (-not $global:cancel) {
        Log '  Cleaning the component store (WinSxS)...' 'White'
        $global:subBase = 80.0; $global:subScale = 0.20
        [void](Run-External 'DISM.exe /Online /Cleanup-Image /StartComponentCleanup')
    }
    $global:subBase = 0.0; $global:subScale = 1.0
}

function Task-Sfc { [void](Run-External 'sfc /scannow') }

function Task-Chk {
    $drv = $env:SystemDrive
    [void](Run-External "echo Y| chkdsk $drv /f /r")
    Log '  CHKDSK on the system drive runs at next restart.' 'Gold'
}


# ---------- Report dialog (used by Space analyzer and SMART) ----------
function New-DialogForm([string]$title, [int]$w, [int]$h) {
    $f = New-Object System.Windows.Forms.Form
    $f.SuspendLayout()
    $f.AutoScaleDimensions = New-Object System.Drawing.SizeF(96.0, 96.0)
    $f.AutoScaleMode = [System.Windows.Forms.AutoScaleMode]::Dpi
    $f.Text = $title
    $f.ClientSize = New-Object System.Drawing.Size($w, $h)
    $f.StartPosition = 'CenterParent'
    $f.BackColor = $cBg
    $f.ForeColor = $cText
    $f.Font = F 10
    $f.FormBorderStyle = 'FixedDialog'
    $f.MaximizeBox = $false; $f.MinimizeBox = $false; $f.ShowInTaskbar = $false
    try { $f.Icon = $form.Icon } catch {}
    if ($global:lang -eq 'ar') { $f.RightToLeft = 'Yes'; $f.RightToLeftLayout = $true }
    return $f
}

function New-DlgButton([string]$text, [int]$x, [int]$y, [int]$w, [bool]$primary) {
    $b = New-Object System.Windows.Forms.Button
    $b.Text = $text
    $b.Location = New-Object System.Drawing.Point($x, $y)
    $b.Size = New-Object System.Drawing.Size($w, 38)
    $b.FlatStyle = 'Flat'; $b.FlatAppearance.BorderSize = 0
    $b.UseCompatibleTextRendering = $false
    $b.Font = F 10 'Bold'
    $b.Cursor = 'Hand'
    if ($primary) { $b.BackColor = $cOrange; $b.ForeColor = $cNavy; $b.FlatAppearance.MouseOverBackColor = $cOrangeH }
    else { $b.BackColor = $cCard; $b.ForeColor = $cText; $b.FlatAppearance.MouseOverBackColor = $cTrack }
    return $b
}

function Show-Report([string]$title, [string]$text) {
    $f = New-DialogForm $title 660 440
    $rb = New-Object System.Windows.Forms.RichTextBox
    $rb.Location = New-Object System.Drawing.Point(14, 14)
    $rb.Size = New-Object System.Drawing.Size(632, 366)
    $rb.BackColor = $cLogBg; $rb.ForeColor = [System.Drawing.Color]::Gainsboro
    $rb.Font = New-Object System.Drawing.Font('Consolas', 9.5, [System.Drawing.FontStyle]::Regular, [System.Drawing.GraphicsUnit]::Point)
    $rb.ReadOnly = $true; $rb.BorderStyle = 'None'; $rb.DetectUrls = $false
    $rb.RightToLeft = 'No'
    $rb.Text = $text
    $f.Controls.Add($rb)
    $ok = New-DlgButton (L 'su_close') 538 388 108 $true
    $ok.DialogResult = 'OK'
    $f.Controls.Add($ok)
    $f.AcceptButton = $ok
    $f.ResumeLayout($false)
    try { [void]$f.ShowDialog($form) } finally { $f.Dispose() }
}

# ---------- Upgrade leftovers: Windows.old, $WINDOWS.~BT, $WINDOWS.~WS ----------
function Task-WinOld {
    $targets = @()
    foreach ($n in @('Windows.old', '$WINDOWS.~BT', '$WINDOWS.~WS')) {
        $p = Join-Path $env:SystemDrive $n
        if ([IO.Directory]::Exists($p)) { $targets += $p }
    }
    if ($targets.Count -eq 0) { Log '  No Windows.old / upgrade leftovers found - nothing to remove.' 'Gray'; return }

    Log '  Measuring (can take a minute)...' 'Gray'
    $total = New-Res
    $prevDry = $global:dry; $global:dry = $true
    try {
        foreach ($p in $targets) {
            $m = Clear-Dir $p
            Log ("  {0}  ->  {1}" -f $p, (Fmt-Size $m.Bytes)) 'White'
            if ($prevDry) { Add-ScanRow ('Upgrade leftovers: ' + [IO.Path]::GetFileName($p)) $m.Bytes $m.Files }
            Add-Res $total $m
            if ($global:cancel) { break }
        }
    } finally { $global:dry = $prevDry }
    if ($global:cancel) { return }

    if ($global:dry) {
        $global:previewTotal += $total.Bytes; Update-FreedLabel
        Log ("  Done. Would free about " + (Fmt-Size $total.Bytes) + '.') 'LimeGreen'
        return
    }
    $r = Msg ((L 'm_winold') -f (Fmt-Size $total.Bytes)) 'YesNo' 'Warning'
    if ($r -ne 'Yes') { Log '  Skipped by user.' 'Gold'; return }

    $i = 0; $n = $targets.Count * 3
    foreach ($p in $targets) {
        if ($global:cancel) { break }
        [void](Run-External ('echo Y| takeown /F "{0}" /R /A' -f $p) -Quiet); $i++; Set-Sub (100.0 * $i / $n)
        if ($global:cancel) { break }
        [void](Run-External ('icacls "{0}" /grant *S-1-5-32-544:F /T /C /Q' -f $p) -Quiet); $i++; Set-Sub (100.0 * $i / $n)
        if ($global:cancel) { break }
        [void](Run-External ('rd /s /q "{0}"' -f $p) -Quiet); $i++; Set-Sub (100.0 * $i / $n)
        if ([IO.Directory]::Exists($p)) {
            $left = Clear-Dir $p
            try { [IO.Directory]::Delete($p, $false) } catch {}
        }
        if ([IO.Directory]::Exists($p)) { Log "  Could not remove everything in $p (some files are protected)." 'Gold' }
        else { Log "  Removed $p" 'LimeGreen' }
    }
    $freed = $total.Bytes
    $global:freedTotal += $freed; Update-FreedLabel
    Log ("  Done. Freed about " + (Fmt-Size $freed) + '.') 'LimeGreen'
}

# ---------- Hibernation file ----------
function Task-Hiber {
    $f = Join-Path $env:SystemDrive 'hiberfil.sys'
    $len = [long]0; $exists = $false
    try { $fi = New-Object IO.FileInfo($f); if ($fi.Exists) { $exists = $true; $len = $fi.Length } } catch {}
    if (-not $exists) { Log '  hiberfil.sys not found - hibernation is already off.' 'Gray'; return }
    Log ("  hiberfil.sys  ->  " + (Fmt-Size $len)) 'White'
    if ($global:dry) {
        $global:previewTotal += $len; Update-FreedLabel
        Add-ScanRow 'Hibernation file (hiberfil.sys)' $len 1
        Log ("  Done. Would free about " + (Fmt-Size $len) + '.') 'LimeGreen'
        return
    }
    $r = Msg ((L 'm_hiber') -f (Fmt-Size $len)) 'YesNo' 'Warning'
    if ($r -ne 'Yes') { Log '  Skipped by user.' 'Gold'; return }
    [void](Run-External 'powercfg /hibernate off' -Quiet)
    Start-Sleep -Milliseconds 800
    $still = $false
    try { $still = (New-Object IO.FileInfo($f)).Exists } catch {}
    if ($still) { Log '  Could not turn hibernation off.' 'Tomato' }
    else {
        $global:freedTotal += $len; Update-FreedLabel
        Log ("  Hibernation turned off. Freed about " + (Fmt-Size $len) + '.') 'LimeGreen'
    }
}

# ---------- Windows Update reset ----------
function Task-WU {
    $win = $env:windir
    $svcs = @('wuauserv', 'bits', 'cryptsvc', 'msiserver')
    $was = @{}
    foreach ($s in $svcs) {
        try {
            $o = Get-Service -Name $s -ErrorAction Stop
            $was[$s] = ($o.Status -eq 'Running')
            if ($was[$s]) { Stop-Service -Name $s -Force -ErrorAction SilentlyContinue }
        } catch {}
    }
    Log '  Update services stopped.' 'Gray'
    $t0 = Get-Date
    while (((Get-Date) - $t0).TotalSeconds -lt 3) { Pump; Start-Sleep -Milliseconds 100 }
    try {
        $paths = @("$win\SoftwareDistribution\Download", "$win\SoftwareDistribution\DataStore", "$win\System32\catroot2")
        $i = 0
        foreach ($p in $paths) {
            if ($global:cancel) { break }
            $i++
            $r = Clear-Dir $p
            Report-Res $p $r
            Set-Sub (100.0 * $i / ($paths.Count + 1))
        }
        $r = Clear-Pattern (Join-Path $env:ProgramData 'Microsoft\Network\Downloader') 'qmgr*.dat'
        Report-Res 'BITS queue (qmgr*.dat)' $r
        Set-Sub 100
    } finally {
        foreach ($s in @('cryptsvc', 'bits', 'wuauserv', 'msiserver')) {
            if ($was[$s]) { try { Start-Service -Name $s -ErrorAction SilentlyContinue } catch {} }
        }
        Log '  Update services restarted.' 'Gray'
    }
    if (-not $global:cancel) { Log '  Windows Update components were reset. Open Windows Update and check for updates again.' 'LimeGreen' }
}

# ---------- Network repair ----------
$global:needRestart = $false
function Task-Net {
    $steps = @(
        @('Flush DNS cache',           'ipconfig /flushdns'),
        @('Reset Winsock catalog',     'netsh winsock reset'),
        @('Reset TCP/IP stack',        'netsh int ip reset'),
        @('Release IP address',        'ipconfig /release'),
        @('Renew IP address',          'ipconfig /renew'),
        @('Re-register DNS',           'ipconfig /registerdns')
    )
    $i = 0
    foreach ($s in $steps) {
        if ($global:cancel) { break }
        $i++
        Log ("  " + $s[0] + '...') 'White'
        [void](Run-External $s[1])
        Set-Sub (100.0 * $i / $steps.Count)
    }
    if (-not $global:cancel) {
        $global:needRestart = $true
        Log '  Network components reset. A restart is recommended to finish.' 'Gold'
    }
}

# ---------- Microsoft Store reset ----------
function Task-Store {
    Log '  Running wsreset (clears the Store cache)...' 'White'
    $p = $null
    try { $p = Start-Process -FilePath wsreset.exe -WindowStyle Hidden -PassThru } catch { Log ('  wsreset failed: ' + $_.Exception.Message) 'Tomato' }
    if ($p) {
        $t0 = Get-Date
        while (-not $p.HasExited -and ((Get-Date) - $t0).TotalSeconds -lt 120) {
            Pump; Start-Sleep -Milliseconds 200
            if ($global:cancel) { break }
        }
        Start-Sleep -Milliseconds 1500
        Get-Process -Name WinStore.App -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue
    }
    Set-Sub 40
    if ($global:cancel) { return }
    Log '  Re-registering the Store app...' 'White'
    $ps = @'
$ErrorActionPreference = 'SilentlyContinue'
foreach ($n in 'Microsoft.WindowsStore', 'Microsoft.StorePurchaseApp', 'Microsoft.DesktopAppInstaller') {
    Get-AppxPackage -AllUsers $n | ForEach-Object {
        Add-AppxPackage -DisableDevelopmentMode -Register ($_.InstallLocation + '\AppXManifest.xml')
    }
}
'@
    [void](Run-PS $ps -Quiet)
    Set-Sub 100
    Log '  Microsoft Store reset finished.' 'LimeGreen'
}

# ---------- Disk space analyzer ----------
function Task-Space {
    $drv = $env:SystemDrive + '\'
    $size1 = @{}; $size2 = @{}
    [long]$rootFiles = 0
    try { foreach ($f in [IO.Directory]::GetFiles($drv)) { try { $rootFiles += (New-Object IO.FileInfo($f)).Length } catch {} } } catch {}
    $tops = New-Object System.Collections.ArrayList
    try {
        foreach ($d in [IO.Directory]::GetDirectories($drv)) {
            try { if (([IO.File]::GetAttributes($d) -band [IO.FileAttributes]::ReparsePoint) -ne 0) { continue } } catch { continue }
            [void]$tops.Add($d)
        }
    } catch {}
    $i = 0; $cnt = 0
    foreach ($top in $tops) {
        if ($global:cancel) { break }
        $i++
        $lblStatus.Text = ("{0}  -  {1}" -f $global:step, $top)
        $size1[$top] = [long]0
        $stack = New-Object 'System.Collections.Generic.Stack[object]'
        $stack.Push(@($top, $null))
        while ($stack.Count -gt 0) {
            if ($global:cancel) { break }
            $item = $stack.Pop(); $d = $item[0]; $a2 = $item[1]
            [long]$bytes = 0
            $di = $null
            try {
                $di = New-Object IO.DirectoryInfo($d)
                foreach ($fi in $di.EnumerateFiles()) { $bytes += $fi.Length }
            } catch {}
            $size1[$top] += $bytes
            if ($a2) { $size2[$a2] += $bytes }
            if ($di) {
                try {
                    foreach ($sd in $di.EnumerateDirectories()) {
                        if (($sd.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) { continue }
                        $na2 = $a2
                        if ($d -eq $top) { $na2 = $sd.FullName; $size2[$na2] = [long]0 }
                        $stack.Push(@($sd.FullName, $na2))
                    }
                } catch {}
            }
            $cnt++
            if (($cnt % 40) -eq 0) { Pump }
        }
        Set-Sub (100.0 * $i / [Math]::Max(1, $tops.Count))
    }
    if ($global:cancel) { return }

    $sb = New-Object System.Text.StringBuilder
    [void]$sb.AppendLine(("Drive {0}  -  {1}" -f $env:SystemDrive, (Get-FreeText)))
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine('TOP 10 LARGEST FOLDERS')
    [void]$sb.AppendLine('----------------------')
    $top10 = @($size2.GetEnumerator() | Sort-Object Value -Descending | Select-Object -First 10)
    foreach ($e in $top10) { [void]$sb.AppendLine(("{0,10}   {1}" -f (Fmt-Size $e.Value), $e.Key)) }
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine('TOP-LEVEL FOLDERS')
    [void]$sb.AppendLine('-----------------')
    foreach ($e in @($size1.GetEnumerator() | Sort-Object Value -Descending | Select-Object -First 8)) {
        [void]$sb.AppendLine(("{0,10}   {1}" -f (Fmt-Size $e.Value), $e.Key))
    }
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine(("{0,10}   Files in the drive root (pagefile, hiberfil, swapfile...)" -f (Fmt-Size $rootFiles)))
    $text = $sb.ToString()
    foreach ($line in ($text -split "`r?`n" | Select-Object -Skip 3 -First 12)) { if ($line.Trim()) { Log ('  ' + $line) 'Gainsboro' } }
    Show-Report (L 'r_space') $text
}

# ---------- Disk health (SMART) ----------
function Task-Smart {
    $sb = New-Object System.Text.StringBuilder
    $warn = 0
    $disks = @()
    try { $disks = @(Get-PhysicalDisk -ErrorAction Stop) } catch {}
    if ($disks.Count -eq 0) {
        try {
            foreach ($d in @(Get-CimInstance Win32_DiskDrive -ErrorAction Stop)) {
                [void]$sb.AppendLine(("{0}   status: {1}   size: {2}" -f $d.Model, $d.Status, (Fmt-Size ([long]$d.Size))))
                if ($d.Status -ne 'OK') { $warn++ }
            }
        } catch { [void]$sb.AppendLine('Could not read disk information on this PC.') }
    }
    foreach ($d in $disks) {
        $name = $d.FriendlyName
        [void]$sb.AppendLine($name)
        [void]$sb.AppendLine(("  Type: {0}   Size: {1}   Bus: {2}" -f $d.MediaType, (Fmt-Size ([long]$d.Size)), $d.BusType))
        [void]$sb.AppendLine(("  Health: {0}   Status: {1}" -f $d.HealthStatus, $d.OperationalStatus))
        if ([string]$d.HealthStatus -ne 'Healthy') { $warn++; [void]$sb.AppendLine('  >> Health is not "Healthy"!') }
        $rel = $null
        try { $rel = $d | Get-StorageReliabilityCounter -ErrorAction Stop } catch {}
        if ($rel) {
            if ($null -ne $rel.Temperature -and $rel.Temperature -gt 0) {
                [void]$sb.AppendLine(("  Temperature: {0} C" -f $rel.Temperature))
                if ($rel.Temperature -ge 60) { $warn++; [void]$sb.AppendLine('  >> Running hot (60 C or more).') }
            }
            if ($null -ne $rel.Wear) {
                [void]$sb.AppendLine(("  Wear: {0}%" -f $rel.Wear))
                if ($rel.Wear -ge 80) { $warn++; [void]$sb.AppendLine('  >> SSD wear is high.') }
            }
            if ($null -ne $rel.PowerOnHours) { [void]$sb.AppendLine(("  Power-on hours: {0:N0}" -f $rel.PowerOnHours)) }
            if ($null -ne $rel.ReadErrorsUncorrected -and $rel.ReadErrorsUncorrected -gt 0) {
                $warn++; [void]$sb.AppendLine(("  >> Uncorrected read errors: {0}" -f $rel.ReadErrorsUncorrected))
            }
        }
        [void]$sb.AppendLine('')
    }
    try {
        foreach ($p in @(Get-CimInstance -Namespace root\wmi -ClassName MSStorageDriver_FailurePredictStatus -ErrorAction Stop)) {
            if ($p.PredictFailure) { $warn++; [void]$sb.AppendLine('>> SMART predicts a disk FAILURE soon!') }
        }
    } catch {}
    if ($warn -gt 0) { [void]$sb.AppendLine((L 'm_smart_warn')) } else { [void]$sb.AppendLine((L 'm_smart_ok')) }
    $text = $sb.ToString()
    foreach ($line in ($text -split "`r?`n")) {
        if (-not $line.Trim()) { continue }
        $c = 'Gainsboro'; if ($line -match '>>|WARNING|تحذير') { $c = 'Gold' }
        Log ('  ' + $line.TrimEnd()) $c
    }
    Set-Sub 100
    Show-Report (L 'r_smart') $text
}

# ---------- Startup programs manager ----------
function Test-ApprovedDisabled($bytes) {
    if ($bytes -and $bytes.Length -gt 0) { return (($bytes[0] -band 1) -eq 1) }
    return $false
}
function New-ApprovedBytes([bool]$enable) {
    $b = New-Object byte[] 12
    if ($enable) { $b[0] = 2 }
    else {
        $b[0] = 3
        $ft = [BitConverter]::GetBytes([DateTime]::UtcNow.ToFileTimeUtc())
        [Array]::Copy($ft, 0, $b, 4, 8)
    }
    return ,$b
}

function Get-StartupItems {
    $list = New-Object System.Collections.ArrayList
    $ap = 'Software\Microsoft\Windows\CurrentVersion\Explorer\StartupApproved'
    $reg = @(
        @('HKCU:\Software\Microsoft\Windows\CurrentVersion\Run',               "HKCU:\$ap\Run",   'User'),
        @('HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Run',               "HKLM:\$ap\Run",   'All users'),
        @('HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Run',   "HKLM:\$ap\Run32", 'All users (32-bit)')
    )
    foreach ($r in $reg) {
        try {
            $k = Get-Item -Path $r[0] -ErrorAction Stop
            $ak = $null
            try { $ak = Get-Item -Path $r[1] -ErrorAction Stop } catch {}
            foreach ($n in $k.GetValueNames()) {
                if (-not $n) { continue }
                $state = $null
                if ($ak) { try { $state = $ak.GetValue($n) } catch {} }
                [void]$list.Add([pscustomobject]@{ Name = $n; Command = [string]$k.GetValue($n); Scope = $r[2]; Approved = $r[1]; Enabled = (-not (Test-ApprovedDisabled $state)) })
            }
        } catch {}
    }
    $fold = @(
        @((Join-Path $env:APPDATA 'Microsoft\Windows\Start Menu\Programs\Startup'),      "HKCU:\$ap\StartupFolder", 'User (folder)'),
        @((Join-Path $env:ProgramData 'Microsoft\Windows\Start Menu\Programs\StartUp'),  "HKLM:\$ap\StartupFolder", 'All users (folder)')
    )
    foreach ($f in $fold) {
        if (-not [IO.Directory]::Exists($f[0])) { continue }
        $ak = $null
        try { $ak = Get-Item -Path $f[1] -ErrorAction Stop } catch {}
        try {
            foreach ($file in [IO.Directory]::GetFiles($f[0])) {
                $n = [IO.Path]::GetFileName($file)
                if ($n -ieq 'desktop.ini') { continue }
                $state = $null
                if ($ak) { try { $state = $ak.GetValue($n) } catch {} }
                [void]$list.Add([pscustomobject]@{ Name = $n; Command = $file; Scope = $f[2]; Approved = $f[1]; Enabled = (-not (Test-ApprovedDisabled $state)) })
            }
        } catch {}
    }
    return @($list)
}

function Set-StartupState($item, [bool]$enable) {
    if (-not (Test-Path -Path $item.Approved)) { [void](New-Item -Path $item.Approved -Force) }
    Set-ItemProperty -Path $item.Approved -Name $item.Name -Value (New-ApprovedBytes $enable) -Type Binary -ErrorAction Stop
}

function Task-Startup {
    $items = @(Get-StartupItems)
    Set-Sub 30
    if ($items.Count -eq 0) { Log '  No startup items found.' 'Gray'; return }
    Log ("  Found {0} startup items." -f $items.Count) 'White'

    $f = New-DialogForm (L 'su_title') 720 500
    $hint = New-Lbl (L 'su_hint') (F 9.5) $cMuted $cBg 14 12 692 24
    if ($global:lang -eq 'ar') { $hint.RightToLeft = 'Yes' }
    $f.Controls.Add($hint)
    $clb = New-Object System.Windows.Forms.CheckedListBox
    $clb.Location = New-Object System.Drawing.Point(14, 44)
    $clb.Size = New-Object System.Drawing.Size(692, 388)
    $clb.BackColor = $cCard; $clb.ForeColor = $cText
    $clb.BorderStyle = 'None'; $clb.CheckOnClick = $true
    $clb.Font = F 9.5
    $clb.HorizontalScrollbar = $true
    $clb.RightToLeft = 'No'
    foreach ($it in $items) {
        $cmd = $it.Command; if ($cmd.Length -gt 70) { $cmd = $cmd.Substring(0, 67) + '...' }
        [void]$clb.Items.Add(("{0}   [{1}]   {2}" -f $it.Name, $it.Scope, $cmd), $it.Enabled)
    }
    $f.Controls.Add($clb)
    $apply = New-DlgButton (L 'su_apply') 480 446 112 $true
    $close = New-DlgButton (L 'su_close') 598 446 108 $false
    $apply.DialogResult = 'OK'; $close.DialogResult = 'Cancel'
    $f.Controls.Add($apply); $f.Controls.Add($close)
    $f.AcceptButton = $apply; $f.CancelButton = $close
    $f.ResumeLayout($false)
    $res = 'Cancel'
    try { $res = $f.ShowDialog($form) } finally {
        $checked = @(); for ($i = 0; $i -lt $items.Count; $i++) { $checked += $clb.GetItemChecked($i) }
        $f.Dispose()
    }
    if ($res -ne 'OK') { Log '  No changes made.' 'Gray'; return }
    $changed = 0
    for ($i = 0; $i -lt $items.Count; $i++) {
        if ($checked[$i] -ne $items[$i].Enabled) {
            try {
                Set-StartupState $items[$i] $checked[$i]
                $changed++
                $st = 'disabled'; if ($checked[$i]) { $st = 'enabled' }
                Log ("  {0}  ->  {1}" -f $items[$i].Name, $st) 'LimeGreen'
            } catch { Log ("  Could not change {0}: {1}" -f $items[$i].Name, $_.Exception.Message) 'Tomato' }
        }
    }
    Log ("  Startup changes applied: {0}. They take effect at the next sign-in." -f $changed) 'LimeGreen'
    Set-Sub 100
}


# ---------- Time estimates (rough, clearly labeled as estimates) ----------
function Fmt-Range([double]$lo, [double]$hi) {
    if ($hi -le 60) { return (L 'est_lt1') }
    $a = [Math]::Max(1, [Math]::Floor($lo / 60))
    $b = [Math]::Max($a, [Math]::Ceiling($hi / 60))
    if ($a -eq $b) { return ((L 'est_min1') -f $b) }
    return ((L 'est_min2') -f $a, $b)
}

function Get-DiskType {
    try {
        $dl = $env:SystemDrive.TrimEnd(':')
        $part = Get-Partition -DriveLetter $dl -ErrorAction Stop
        $pd = Get-PhysicalDisk -ErrorAction Stop | Where-Object { [string]$_.DeviceId -eq [string]$part.DiskNumber } | Select-Object -First 1
        if ($pd -and ([string]$pd.MediaType -eq 'HDD')) { return 'HDD' }
    } catch {}
    return 'SSD'
}

function Get-Estimate([string]$key) {
    $hdd = ($global:diskType -eq 'HDD')
    $lo = 0.0; $hi = 0.0; $card = ''; $detail = ''
    $filesBased = @{ clean = @(20, 120, 1.0); deep = @(60, 300, 1.0); web = @(15, 90, 1.0); winold = @(120, 1200, 0.3); hiber = @(3, 20, 1.0) }
    if ($filesBased.ContainsKey($key)) {
        $def = $filesBased[$key]
        $sc = $null
        if ($global:scan.ContainsKey($key)) { $sc = $global:scan[$key] }
        if ($sc) {
            $rate = 800.0; if ($hdd) { $rate = 250.0 }
            $rate = $rate * $def[2]
            $f = [double]$sc.Files
            $lo = 5 + $f / ($rate * 1.5); $hi = 10 + $f / ($rate * 0.6)
            $size = Fmt-Size $sc.Bytes
            $rng = Fmt-Range $lo $hi
            $card = ('{0} | {1}' -f $size, $rng)
            $detail = (L 'est_from_scan') -f $size, $rng
        } else {
            $lo = $def[0]; $hi = $def[1]
            $card = Fmt-Range $lo $hi
            $detail = (L 'est_no_scan') -f $card
        }
    }
    elseif ($key -eq 'logs') {
        $n = 1000.0; $known = $false
        if ($global:scan.ContainsKey('logcount') -and $global:scan['logcount']) { $n = [double]$global:scan['logcount']; $known = $true }
        $lo = [Math]::Max(10, $n * 0.07); $hi = [Math]::Max(30, $n * 0.2)
        $r = Fmt-Range $lo $hi
        if ($known) { $card = (L 'est_logs_card') -f $n, $r } else { $card = $r }
        $detail = $r
    }
    elseif ($key -eq 'dism') {
        if ($hdd) { $lo = 600; $hi = 2400 } else { $lo = 180; $hi = 1200 }
        $lo += 60; $hi += 300   # component store cleanup
        $card = Fmt-Range $lo $hi; $detail = $card
    }
    elseif ($key -eq 'sfc') {
        if ($hdd) { $lo = 600; $hi = 2100 } else { $lo = 240; $hi = 900 }
        $card = Fmt-Range $lo $hi; $detail = $card
    }
    elseif ($key -eq 'chk') {
        $used = 100.0
        try { $used = (Get-PSDrive ($env:SystemDrive.TrimEnd(':')) -ErrorAction Stop).Used / 1GB } catch {}
        if ($hdd) { $a = $used * 0.3; $b = $used * 1.0 } else { $a = $used * 0.08; $b = $used * 0.3 }
        $a = [Math]::Max(10, [Math]::Round($a)); $b = [Math]::Max($a + 5, [Math]::Round($b))
        $lo = 5; $hi = 15
        $card = (L 'est_chk_card') -f $a, $b
        $detail = (L 'est_chk_detail') -f $a, $b
    }
    elseif ($key -eq 'wu')      { $lo = 20; $hi = 90;  $card = Fmt-Range $lo $hi; $detail = $card }
    elseif ($key -eq 'net')     { $lo = 15; $hi = 60;  $card = Fmt-Range $lo $hi; $detail = $card }
    elseif ($key -eq 'store')   { $lo = 30; $hi = 150; $card = Fmt-Range $lo $hi; $detail = $card }
    elseif ($key -eq 'space')   {
        if ($hdd) { $lo = 120; $hi = 900 } else { $lo = 30; $hi = 300 }
        $card = Fmt-Range $lo $hi; $detail = $card
    }
    else { $lo = 5; $hi = 30; $card = Fmt-Range $lo $hi; $detail = $card }   # startup, smart
    return [pscustomobject]@{ Lo = $lo; Hi = $hi; Card = $card; Detail = $detail }
}

function Update-Estimates {
    foreach ($t in $tasks) { try { $t.Est.Text = (Get-Estimate $t.Key).Card } catch {} }
}

# ---------- Preview results: largest first, with file counts and a total ----------
function Show-ScanSummary {
    $rows = @($global:scanRows | Sort-Object Bytes -Descending)
    [long]$tb = 0; [long]$tf = 0
    foreach ($r in $rows) { $tb += $r.Bytes; $tf += $r.Files }
    $sb = New-Object System.Text.StringBuilder
    [void]$sb.AppendLine((L 'r_cols'))
    [void]$sb.AppendLine(('-' * 70))
    $shown = 0
    foreach ($r in $rows) {
        $line = ('{0,12}  {1,9:N0}   {2}' -f (Fmt-Size $r.Bytes), $r.Files, $r.Label)
        [void]$sb.AppendLine($line)
        if ($shown -lt 8) { Log ('  {0} {1}  ({2:N0} files)' -f ([string]$r.Label).PadRight(40, '.'), (Fmt-Size $r.Bytes), $r.Files) 'Gainsboro'; $shown++ }
    }
    if ($rows.Count -gt 8) { Log ("  ... +{0} more items (see the results window)" -f ($rows.Count - 8)) 'Gray' }
    [void]$sb.AppendLine(('-' * 70))
    $tot = (L 'r_total') -f (Fmt-Size $tb), $tf
    [void]$sb.AppendLine($tot)
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine((L 'r_note'))
    Log ('  ' + $tot) 'LimeGreen'
    Log ('  ' + (L 'r_note')) 'Gray'
    if ($rows.Count -gt 0) { Show-Report (L 'r_prev') $sb.ToString() }
}

# ---------- Button look: dimmed when not available ----------
function Set-BtnLook($b, [bool]$on) {
    $b.Enabled = $on
    if ($on) {
        $b.ForeColor = $b.Tag.Fore; $b.BackColor = $b.Tag.Back
        $b.FlatAppearance.MouseOverBackColor = $b.Tag.Hover
        $b.Cursor = 'Hand'
    } else {
        $b.ForeColor = $cDim; $b.BackColor = $cCard
        $b.FlatAppearance.MouseOverBackColor = $cCard
        $b.Cursor = 'Default'
    }
}

function Set-Busy([bool]$busy) {
    $global:running = $busy
    Set-BtnLook $btnRun     (-not $busy)
    Set-BtnLook $btnPreview (-not $busy)
    Set-BtnLook $btnAll     (-not $busy)
    Set-BtnLook $btnLang    (-not $busy)
    Set-BtnLook $btnCancel  $busy
    $cbRestore.Enabled = (-not $busy)
    foreach ($t in $tasks) { $t.Box.Enabled = (-not $busy) }
}

# ---------- Mirror a control inside its parent (used for Arabic right-to-left cards) ----------
$global:fx = @{}
function Mirror-Ctl($ctl, $parent, [bool]$rtl) {
    $key = [System.Runtime.CompilerServices.RuntimeHelpers]::GetHashCode($ctl)   # identity-based, unique per control
    if (-not $global:fx.ContainsKey($key)) { $global:fx[$key] = [double]$ctl.Left / [double]$parent.Width }
    $r = $global:fx[$key]
    if ($rtl) { $ctl.Left = [int]($parent.Width - ($parent.Width * $r) - $ctl.Width) }
    else { $ctl.Left = [int]($parent.Width * $r) }
}

