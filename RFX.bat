function L([string]$k) {
    $v = $null
    try { $v = $LangTable[$global:lang][$k] } catch {}
    if (-not $v) { try { $v = $LangTable['en'][$k] } catch {} }
    if (-not $v) { $v = $k }
    return $v
}

# MessageBox that follows the current language (RTL for Arabic)
function Msg([string]$text, [string]$buttons = 'OK', [string]$icon = 'Information') {
    $o = [System.Windows.Forms.MessageBoxOptions]0
    if ($global:lang -eq 'ar') { $o = [System.Windows.Forms.MessageBoxOptions]'RtlReading, RightAlign' }
    return [System.Windows.Forms.MessageBox]::Show($form, $text, (L 'm_title'), $buttons, $icon, 'Button1', $o)
}

# ---------- Generic helpers ----------
function Pump { [System.Windows.Forms.Application]::DoEvents() }

function Enable-DB($c) {
    try { $c.GetType().GetProperty('DoubleBuffered', [Reflection.BindingFlags]'NonPublic,Instance').SetValue($c, $true, $null) } catch {}
}

function Log($t, $color = 'Gainsboro') {
    $log.SelectionStart = $log.TextLength
    $log.SelectionColor = [System.Drawing.Color]::FromName($color)
    $log.AppendText("$t`r`n")
    $log.ScrollToCaret()
    Pump
}

function Set-Progress([int]$p, [string]$wordKey) {
    $global:pct = [Math]::Max(0, [Math]::Min(100, $p))
    if ($wordKey) { $global:wordKey = $wordKey }
    $ring.Invalidate()
    Pump
}

function Set-Sub([double]$sub) {
    $eff = $global:subBase + ($sub * $global:subScale)
    $lblStatus.Text = ("{0}  -  {1:N0}%" -f $global:step, $eff)
    if ($global:total -gt 0) {
        Set-Progress ([int](100 * (($global:idx - 1) + $eff / 100) / $global:total)) 'w_running'
    }
}

function Fmt-Size($b) {
    if ($b -ge 1GB) { return ('{0:N2} GB' -f ($b / 1GB)) }
    elseif ($b -ge 1MB) { return ('{0:N1} MB' -f ($b / 1MB)) }
    else { return ('{0:N0} KB' -f ($b / 1KB)) }
}

function Get-FreeText {
    try {
        $d = Get-PSDrive ($env:SystemDrive.TrimEnd(':')) -ErrorAction Stop
        return ((L 'disk_fmt') -f $env:SystemDrive, (Fmt-Size $d.Free), (Fmt-Size ($d.Free + $d.Used)))
    } catch { return 'Disk: n/a' }
}

function Short-Path([string]$p, [int]$max = 78) {
    if ($p.Length -le $max) { return $p }
    return ($p.Substring(0, 24) + ' ... ' + $p.Substring($p.Length - ($max - 29)))
}

# ---------- Safe deletion engine ----------
function New-Res { return @{ Bytes = [long]0; Files = 0; Skipped = 0 } }
function Add-Res($a, $b) { $a.Bytes += $b.Bytes; $a.Files += $b.Files; $a.Skipped += $b.Skipped }

# Deletes everything INSIDE $Path (never the folder itself). Works with spaces, [brackets],
# skips junctions/symlinks, skips files that are in use, and counts the bytes really freed.
function Clear-Dir([string]$Path) {
    $res = New-Res
    if (-not $Path -or -not [IO.Directory]::Exists($Path)) { return $res }
    $stack = New-Object 'System.Collections.Generic.Stack[string]'
    $dirs  = New-Object 'System.Collections.Generic.List[string]'
    $stack.Push($Path)
    $n = 0
    while ($stack.Count -gt 0) {
        if ($global:cancel) { break }
        $d = $stack.Pop()
        $dirs.Add($d)
        $subs = @()
        try { $subs = [IO.Directory]::GetDirectories($d) } catch {}
        foreach ($s in $subs) {
            try {
                $attr = [IO.File]::GetAttributes($s)
                if (($attr -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
                    # Junction / symlink: remove only the link itself, never follow it
                    if (-not $global:dry) { try { [IO.Directory]::Delete($s, $false) } catch {} }
                    continue
                }
            } catch { continue }
            $stack.Push($s)
        }
        $files = @()
        try { $files = [IO.Directory]::GetFiles($d) } catch {}
        foreach ($f in $files) {
            try {
                $fi = New-Object IO.FileInfo($f)
                $len = $fi.Length
                if (-not $global:dry) {
                    try { if ($fi.IsReadOnly) { $fi.IsReadOnly = $false } } catch {}
                    $fi.Delete()
                }
                $res.Bytes += $len; $res.Files++
            } catch { $res.Skipped++ }
            $n++
            if (($n % 150) -eq 0) { Pump; if ($global:cancel) { break } }
        }
    }
    if (-not $global:dry) {
        for ($i = $dirs.Count - 1; $i -ge 1; $i--) {
            try { [IO.Directory]::Delete($dirs[$i], $false) } catch {}
        }
    }
    return $res
}

# Deletes files matching a pattern in ONE folder (thumbnail cache, dumps, ...)
function Clear-Pattern([string]$Dir, [string]$Pattern) {
    $res = New-Res
    if (-not $Dir -or -not [IO.Directory]::Exists($Dir)) { return $res }
    $files = @()
    try { $files = [IO.Directory]::GetFiles($Dir, $Pattern) } catch { return $res }
    foreach ($f in $files) {
        try {
            $fi = New-Object IO.FileInfo($f)
            $len = $fi.Length
            if (-not $global:dry) {
                try { if ($fi.IsReadOnly) { $fi.IsReadOnly = $false } } catch {}
                $fi.Delete()
            }
            $res.Bytes += $len; $res.Files++
        } catch { $res.Skipped++ }
    }
    return $res
}

function Verb { if ($global:dry) { return 'Would free' } else { return 'Freed' } }

function Update-FreedLabel {
    try {
        if ($global:dry) { $lblFreed.Text = (L 'preview_lbl') -f (Fmt-Size $global:previewTotal) }
        else { $lblFreed.Text = (L 'freed') -f (Fmt-Size $global:freedTotal) }
    } catch {}
}

function Get-RecycleSize {
    [long]$t = 0
    try {
        $sh = New-Object -ComObject Shell.Application
        $ns = $sh.Namespace(10)
        foreach ($it in @($ns.Items())) { try { $t += [long]$it.Size } catch {} }
    } catch {}
    return $t
}


function Add-Target($set, $list, [string]$p, [string]$label = '', [string]$pattern = '') {
    if (-not $p) { return }
    try { $full = [IO.Path]::GetFullPath($p) } catch { return }
    if ($full.Length -gt 3) { $full = $full.TrimEnd('\') }
    if ($set.Add($full + '|' + $pattern)) { [void]$list.Add([pscustomobject]@{ P = $full; L = $label; Pat = $pattern }) }
}

# One row per item in the Preview table (same label in the same task is merged)
function Add-ScanRow([string]$label, [long]$bytes, [long]$files) {
    if ($bytes -le 0 -and $files -le 0) { return }
    foreach ($r in $global:scanRows) {
        if ($r.Key -eq $global:curKey -and $r.Label -eq $label) { $r.Bytes += $bytes; $r.Files += $files; return }
    }
    [void]$global:scanRows.Add([pscustomobject]@{ Key = $global:curKey; Label = $label; Bytes = $bytes; Files = $files })
}

function Report-Res([string]$label, $r) {
    if ($global:dry) { $global:previewTotal += $r.Bytes; Add-ScanRow $label $r.Bytes $r.Files }
    else { $global:freedTotal += $r.Bytes }
    Update-FreedLabel
    if (-not $global:dry -and ($r.Files -gt 0 -or $r.Skipped -gt 0)) {
        $extra = ''
        if ($r.Skipped -gt 0) { $extra = ", $($r.Skipped) in use" }
        $col = 'Gray'
        if ($r.Bytes -gt 0) { $col = 'LimeGreen' }
        Log ("  {0} {1}  ({2:N0} files{3})" -f ([string]$label).PadRight(40, '.'), (Fmt-Size $r.Bytes), $r.Files, $extra) $col
    }
}

# Cleans a list of targets (folders or file patterns), merges results per label, reports largest first
function Clear-Targets($items, [double]$scaleTo = 100) {
    $agg = [ordered]@{}
    $sum = New-Res
    $i = 0; $n = [Math]::Max(1, @($items).Count)
    foreach ($it in $items) {
        if ($global:cancel) { break }
        $i++
        $lbl = $it.L
        if (-not $lbl) { $lbl = $it.P }
        if ($it.Pat) { $r = Clear-Pattern $it.P $it.Pat } else { $r = Clear-Dir $it.P }
        if (-not $agg.Contains($lbl)) { $agg[$lbl] = New-Res }
        Add-Res $agg[$lbl] $r
        Add-Res $sum $r
        if (($i % 4) -eq 0 -or $i -eq $n) { Set-Sub ($scaleTo * $i / $n) }
    }
    foreach ($e in @($agg.GetEnumerator() | Sort-Object { $_.Value.Bytes } -Descending)) { Report-Res $e.Key $e.Value }
    return $sum
}

# 1) Temporary files: %TEMP%, Windows Temp, Prefetch, service profiles, every user's Temp, legacy folders
function Task-Clean {
    $set = New-TargetSet
    $list = New-Object System.Collections.ArrayList
    $win = $env:windir
    Log "  %TEMP% = $env:TEMP" 'Gray'
    Add-Target $set $list $env:TEMP 'User Temp (%TEMP%)'
    Add-Target $set $list $env:TMP  'User Temp (%TEMP%)'
    Add-Target $set $list (Join-Path $win 'Temp') 'Windows Temp'
    Add-Target $set $list (Join-Path $win 'Prefetch') 'Prefetch'
    Add-Target $set $list (Join-Path $win 'ServiceProfiles\LocalService\AppData\Local\Temp') 'Service temp (LocalService)'
    Add-Target $set $list (Join-Path $win 'ServiceProfiles\NetworkService\AppData\Local\Temp') 'Service temp (NetworkService)'
    Add-Target $set $list (Join-Path $win 'System32\config\systemprofile\AppData\Local\Temp') 'System profile temp'
    foreach ($u in (Get-ProfileDirs)) { Add-Target $set $list (Join-Path $u 'AppData\Local\Temp') 'User Temp (other profiles)' }
    # Legacy locations (harmless if they do not exist)
    foreach ($lg in @(
        @('Tmp', 'Legacy: Windows\Tmp'), @('Temporary Internet Files', 'Legacy: Temporary Internet Files'),
        @('History', 'Legacy: Windows\History'), @('Cookies', 'Legacy: Windows\Cookies'), @('Recent', 'Legacy: Windows\Recent')
    )) { Add-Target $set $list (Join-Path $win $lg[0]) $lg[1] }
    Add-Target $set $list $win 'Legacy: Windows\ff*.tmp' 'ff*.tmp'
    Add-Target $set $list ($env:SystemDrive + '\') 'Legacy: WIN386.SWP' 'WIN386.SWP'

    $sum = Clear-Targets $list 100
    Log ("  Done. $(Verb) about " + (Fmt-Size $sum.Bytes) + " from temporary folders.") 'LimeGreen'
}

# 2) Deep system cache
function Task-Deep {
    $set = New-TargetSet
    $list = New-Object System.Collections.ArrayList
    $win = $env:windir
    $pd  = $env:ProgramData

    foreach ($e in @(
        @("$win\SoftwareDistribution\Download", 'Windows Update download cache'),
        @("$win\SoftwareDistribution\DeliveryOptimization", 'Delivery Optimization cache'),
        @("$win\ServiceProfiles\NetworkService\AppData\Local\Microsoft\Windows\DeliveryOptimization\Cache", 'Delivery Optimization cache'),
        @("$win\System32\spool\PRINTERS", 'Print spooler queue'),
        @("$win\Logs\CBS", 'CBS logs'), @("$win\Logs\DISM", 'DISM logs'), @("$win\Logs\WindowsUpdate", 'Windows Update logs'),
        @("$win\Minidump", 'Minidumps'), @("$win\LiveKernelReports", 'Live kernel reports'),
        @("$pd\Microsoft\Windows\WER\ReportQueue", 'Error Reporting (queue)'),
        @("$pd\Microsoft\Windows\WER\ReportArchive", 'Error Reporting (archive)'),
        @("$pd\Microsoft\Windows\WER\Temp", 'Error Reporting (temp)'),
        @("$pd\NVIDIA Corporation\NV_Cache", 'NVIDIA shader cache'), @("$pd\NVIDIA\DXCache", 'NVIDIA shader cache')
    )) { Add-Target $set $list $e[0] $e[1] }
    Add-Target $set $list $win 'Memory dump (MEMORY.DMP)' 'MEMORY.DMP'

    foreach ($u in (Get-ProfileDirs)) {
        $L = Join-Path $u 'AppData\Local'
        foreach ($e in @(
            @('Microsoft\Windows\INetCache', 'Internet cache (INetCache)'),
            @('Microsoft\Windows\WER', 'Error Reporting (user)'),
            @('CrashDumps', 'Crash dumps (user)'),
            @('D3DSCache', 'DirectX shader cache'),
            @('NVIDIA\DXCache', 'NVIDIA shader cache'), @('NVIDIA\GLCache', 'NVIDIA shader cache'),
            @('AMD\DxCache', 'AMD shader cache'), @('AMD\GLCache', 'AMD shader cache'),
            @('Intel\ShaderCache', 'Intel shader cache'),
            @('Microsoft\Terminal Server Client\Cache', 'Remote Desktop cache')
        )) { Add-Target $set $list (Join-Path $L $e[0]) $e[1] }
        Add-Target $set $list (Join-Path $u 'AppData\LocalLow\NVIDIA\PerDriverVersion\DXCache') 'NVIDIA shader cache'
        $pk = Join-Path $L 'Packages'
        if ([IO.Directory]::Exists($pk)) {
            try { foreach ($d in [IO.Directory]::GetDirectories($pk)) { Add-Target $set $list (Join-Path $d 'TempState') 'Store apps temp' } } catch {}
        }
        $ex = Join-Path $L 'Microsoft\Windows\Explorer'
        Add-Target $set $list $ex 'Thumbnail cache' 'thumbcache_*.db'
        Add-Target $set $list $ex 'Icon cache' 'iconcache_*.db'
        Add-Target $set $list $L 'Icon cache' 'IconCache.db'
        Add-Target $set $list (Join-Path $u 'AppData\Roaming\Microsoft\Windows\Recent') 'Recent items (shortcuts only)' '*.lnk'
    }

    # Pause services that lock these caches, restore them afterwards
    $was = @{}
    if (-not $global:dry) {
        foreach ($s in @('wuauserv', 'bits', 'dosvc', 'Spooler')) {
            try {
                $o = Get-Service -Name $s -ErrorAction Stop
                $was[$s] = ($o.Status -eq 'Running')
                if ($was[$s]) {
                    Stop-Service -Name $s -Force -ErrorAction SilentlyContinue
                    try { $o.WaitForStatus('Stopped', [TimeSpan]::FromSeconds(15)) } catch {}
                }
            } catch {}
        }
        Log '  Update and print services paused while cleaning their caches.' 'Gray'
        Pump
    }

    $sum = New-Res
    try {
        $sum = Clear-Targets $list 88
    } finally {
        foreach ($s in @('Spooler', 'dosvc', 'bits', 'wuauserv')) {
            if ($was[$s]) { try { Start-Service -Name $s -ErrorAction SilentlyContinue } catch {} }
        }
        if (-not $global:dry) { Log '  Services restored.' 'Gray' }
    }

    if (-not $global:cancel -and $global:dry) {
        $rb = Get-RecycleSize
        $global:previewTotal += $rb
        Update-FreedLabel
        $sum.Bytes += $rb
        Add-ScanRow 'Recycle Bin' $rb 0
        Set-Sub 95
    }
    if (-not $global:cancel -and -not $global:dry) {
        try {
            Clear-RecycleBin -Force -ErrorAction Stop
            Log ('  {0} emptied' -f 'Recycle Bin'.PadRight(40, '.')) 'LimeGreen'
        } catch {
            foreach ($d in [IO.DriveInfo]::GetDrives()) {
                if ($d.DriveType -eq 'Fixed') { [void](Run-External ('rd /s /q "{0}$Recycle.Bin"' -f $d.Name)) }
            }
            Log ('  {0} cleared (fallback)' -f 'Recycle Bin'.PadRight(40, '.')) 'LimeGreen'
        }
        Set-Sub 95
        [void](Run-External 'ipconfig /flushdns')
        Set-Sub 100
    }
    Log ("  Done. $(Verb) about " + (Fmt-Size $sum.Bytes) + $(if ($global:dry) { " (including Recycle Bin)." } else { " (plus Recycle Bin)." })) 'LimeGreen'
}

# 3) Browser caches (cache only - passwords, cookies, history and bookmarks are NOT touched)
function Task-Browsers {
    $running = @()
    foreach ($pn in @('chrome', 'msedge', 'firefox', 'brave', 'opera', 'vivaldi')) {
        if (Get-Process -Name $pn -ErrorAction SilentlyContinue) { $running += $pn }
    }
    if ($running.Count -gt 0) {
        Log ("  Tip: close these browsers for a full clean: " + ($running -join ', ')) 'Gold'
    }

    $set = New-TargetSet
    $list = New-Object System.Collections.ArrayList
    $chromium = @(
        @('Chrome',  'Google\Chrome\User Data'),
        @('Edge',    'Microsoft\Edge\User Data'),
        @('Brave',   'BraveSoftware\Brave-Browser\User Data'),
        @('Vivaldi', 'Vivaldi\User Data'),
        @('Chromium','Chromium\User Data')
    )
    $sub = @('Cache', 'Code Cache', 'GPUCache', 'DawnCache', 'GraphiteDawnCache', 'Service Worker\CacheStorage', 'Service Worker\ScriptCache', 'Application Cache')
    $rootSub = @('ShaderCache', 'GrShaderCache', 'GraphiteDawnCache', 'DawnCache')

    foreach ($u in (Get-ProfileDirs)) {
        $L = Join-Path $u 'AppData\Local'
        foreach ($b in $chromium) {
            $root = Join-Path $L $b[1]
            if (-not [IO.Directory]::Exists($root)) { continue }
            $lbl = $b[0] + ' cache'
            foreach ($rs in $rootSub) { Add-Target $set $list (Join-Path $root $rs) $lbl }
            try {
                foreach ($pd in [IO.Directory]::GetDirectories($root)) {
                    $nm = [IO.Path]::GetFileName($pd)
                    if ($nm -eq 'Default' -or $nm -like 'Profile *' -or $nm -eq 'Guest Profile') {
                        foreach ($s in $sub) { Add-Target $set $list (Join-Path $pd $s) $lbl }
                    }
                }
            } catch {}
        }
        # Opera / Opera GX (profile folder is the root itself)
        foreach ($o in @(
            @('Opera cache', (Join-Path $L 'Opera Software\Opera Stable')),
            @('Opera cache', (Join-Path $u 'AppData\Roaming\Opera Software\Opera Stable')),
            @('Opera GX cache', (Join-Path $L 'Opera Software\Opera GX Stable')),
            @('Opera GX cache', (Join-Path $u 'AppData\Roaming\Opera Software\Opera GX Stable'))
        )) {
            if (-not [IO.Directory]::Exists($o[1])) { continue }
            foreach ($s in $sub) { Add-Target $set $list (Join-Path $o[1] $s) $o[0] }
        }
        # Firefox
        $ff = Join-Path $L 'Mozilla\Firefox\Profiles'
        if ([IO.Directory]::Exists($ff)) {
            try {
                foreach ($pd in [IO.Directory]::GetDirectories($ff)) {
                    foreach ($s in @('cache2', 'startupCache', 'jumpListCache', 'thumbnails')) { Add-Target $set $list (Join-Path $pd $s) 'Firefox cache' }
                }
            } catch {}
        }
    }

    if ($list.Count -eq 0) { Log '  No supported browsers found.' 'Gray' }
    $sum = Clear-Targets $list 100
    Log ("  Done. $(Verb) about " + (Fmt-Size $sum.Bytes) + " from browser caches.") 'LimeGreen'
}


# NOTE: unary comma keeps PowerShell from unrolling the (empty) set into $null
function New-TargetSet { return ,(New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)) }

# Every real user profile on the PC (not Public/Default)
function Get-ProfileDirs {
    $out = New-Object System.Collections.ArrayList
    $root = Join-Path $env:SystemDrive 'Users'
    $skip = @('Public', 'Default', 'Default User', 'All Users', 'desktop.ini')
    try {
        foreach ($d in [IO.Directory]::GetDirectories($root)) {
            $n = [IO.Path]::GetFileName($d)
            if ($skip -contains $n) { continue }
            [void]$out.Add($d)
        }
    } catch {}
    return @($out)
}

# ---------- External commands ----------
function Read-Tail($file) {
    if (-not (Test-Path -LiteralPath $file)) { return }
    $buf = $null; $n = 0
    try {
        $fs = [IO.File]::Open($file, 'Open', 'Read', 'ReadWrite')
        try {
            if ($fs.Length -le $global:tailPos) { return }
            [void]$fs.Seek($global:tailPos, 'Begin')
            $buf = New-Object byte[] ($fs.Length - $global:tailPos)
            $n = $fs.Read($buf, 0, $buf.Length)
            $global:tailPos += $n
        } finally { $fs.Close() }
    } catch { return }
    if ($n -le 0) { return }
    $text = [Text.Encoding]::UTF8.GetString($buf, 0, $n) -replace "`0", ''
    foreach ($line in ($text -split "[\r\n]+")) {
        $l = $line.Trim()
        if (-not $l) { continue }
        if ($l -match '^\[[= ]*([\d\.]+)%[= ]*\]$') { Set-Sub ([double]$Matches[1]); continue }
        if ($l -match 'Verification\s+(\d+)%') { Set-Sub ([double]$Matches[1]); continue }
        Log "  $l" 'Gainsboro'
    }
}

function Run-External($cmd, [switch]$Quiet) {
    $tmp = Join-Path $global:WorkDir ('x_' + [guid]::NewGuid().ToString('N') + '.log')
    $global:tailPos = 0
    $p = Start-Process -FilePath cmd.exe -ArgumentList "/c $cmd > `"$tmp`" 2>&1" -WindowStyle Hidden -PassThru
    while (-not $p.HasExited) {
        if (-not $Quiet) { Read-Tail $tmp }
        Pump
        Start-Sleep -Milliseconds 150
        if ($global:cancel) {
            & taskkill.exe /PID $p.Id /T /F 2>&1 | Out-Null
            Log '  Cancelled.' 'Gold'
            break
        }
    }
    if (-not $Quiet) { Read-Tail $tmp }
    Remove-Item -LiteralPath $tmp -Force -ErrorAction SilentlyContinue
    try { if ($p.HasExited) { return $p.ExitCode } } catch {}
    return -1
}

# Runs PowerShell code in a separate hidden process (keeps the window responsive, can be cancelled)
function Run-PS([string]$scriptText, [switch]$Quiet) {
    $pre = "`$ProgressPreference = 'SilentlyContinue'`r`n"
    $enc = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($pre + $scriptText))
    return (Run-External "powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand $enc" -Quiet:$Quiet)
}

