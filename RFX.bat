# Title in two colours. Widths are measured in real pixels, so this must run after the window is scaled
# (Apply-Lang calls it, and the Shown event calls it again once Windows has applied the DPI scaling).
function Layout-Title {
    $k = $hdr.Width / 1000.0
    if ($global:lang -eq 'ar') {
        $lblTitle.Text = L 'title'
        $lblTitle.Width = [int](580 * $k)
        $lblTitle2.Visible = $false
        return
    }
    $lblTitle.Text  = L 'title_a'
    $lblTitle2.Text = L 'title_b'
    try {
        $flags = [System.Windows.Forms.TextFormatFlags]::NoPadding -bor [System.Windows.Forms.TextFormatFlags]::SingleLine
        $w = [System.Windows.Forms.TextRenderer]::MeasureText($lblTitle.Text, $lblTitle.Font, (New-Object System.Drawing.Size(2000, 200)), $flags).Width
        $lblTitle.Width = $w + [int](4 * $k)
        $lblTitle2.Left = $lblTitle.Left + $lblTitle.Width + [int](8 * $k)
        $lblTitle2.Width = [int](300 * $k)
        $lblTitle2.Visible = $true
    } catch {
        $lblTitle.Text = L 'title'; $lblTitle.Width = [int](580 * $k); $lblTitle2.Visible = $false
    }
}

function Select-Tab([int]$i) {
    $global:curTab = $i
    for ($k = 0; $k -lt 3; $k++) {
        $pages[$k].Visible = ($k -eq $i)
        $b = $tabBtns[$k]
        if ($k -eq $i) {
            $b.BackColor = $cOrange; $b.ForeColor = $cNavy; $b.FlatAppearance.MouseOverBackColor = $cOrangeH
        } else {
            $b.BackColor = $cCard; $b.ForeColor = $cText; $b.FlatAppearance.MouseOverBackColor = $cTrack
        }
    }
}

function Update-Tabs {
    for ($k = 0; $k -lt 3; $k++) {
        $n = @($tasks | Where-Object { $_.Page -eq $k -and $_.Box.Checked }).Count
        $txt = L ('tab' + $k)
        if ($n -gt 0) { $txt = "$txt  ($n)" }
        $tabBtns[$k].Text = $txt
    }
}

function Update-Info {
    $lblPc.Text   = (L 'pc_fmt') -f $env:COMPUTERNAME
    $lblOs.Text   = (L 'os_fmt') -f $global:osName
    $lblDisk.Text = Get-FreeText
    Update-FreedLabel
}

function Update-Footer {
    if ($global:updVer) {
        $lblVer.Text = (L 'upd') -f $global:updVer
        $lblVer.ForeColor = $cOrange
        $lblVer.Font = F 9 'Bold'
        $lblVer.Cursor = 'Hand'
    } else {
        $lblVer.Text = "{0} {1}   |   {2}" -f (L 'version'), $global:Version, $global:BuildDate
        $lblVer.ForeColor = $cMuted
        $lblVer.Font = F 9
        $lblVer.Cursor = 'Default'
    }
}

$lblVer.Add_Click({ if ($global:updUrl) { try { Start-Process explorer.exe -ArgumentList $global:updUrl } catch { try { Start-Process $global:updUrl } catch {} } } })

function Apply-Lang {
    $rtl = ($global:lang -eq 'ar')
    $rd = 'No'; if ($rtl) { $rd = 'Yes' }
    $form.SuspendLayout()

    Layout-Title
    $lblSub.Text   = (L 'sub') -replace '\*', $dot
    $btnLang.Text  = L 'btn_lang'
    $btnRun.Text = L 'btn_run'; $btnPreview.Text = L 'btn_prev'; $btnCancel.Text = L 'btn_cancel'
    $btnAll.Text = L 'btn_all'; $btnSave.Text = L 'btn_save'

    foreach ($t in $tasks) {
        $t.Box.Text  = L ('t_' + $t.Key)
        $t.Desc.Text = L ('d_' + $t.Key)
        $t.Box.RightToLeft = $rd
        $t.Desc.RightToLeft = $rd
        $t.Est.RightToLeft = $rd
        Mirror-Ctl $t.Acc  $t.Card $rtl
        Mirror-Ctl $t.Box  $t.Card $rtl
        Mirror-Ctl $t.Desc $t.Card $rtl
        Mirror-Ctl $t.Est  $t.Card $rtl
    }
    $cbRestore.Text = L 'restore_t'
    $rdesc.Text = L 'restore_d'
    $cbRestore.RightToLeft = $rd
    $rdesc.RightToLeft = $rd
    Mirror-Ctl $racc       $rcard $rtl
    Mirror-Ctl $cbRestore  $rcard $rtl
    Mirror-Ctl $rdesc      $rcard $rtl
    foreach ($l in @($lblPc, $lblOs, $lblDisk, $lblFreed)) { $l.RightToLeft = $rd }

    Update-Tabs
    Update-Estimates
    Update-Info
    Update-Footer
    if (-not $global:running) {
        if ($global:pct -eq 0) { $lblStatus.Text = L 'ready' }
    }
    $ring.Invalidate(); $pill.Invalidate()
    $form.ResumeLayout($true)
}

$btnLang.Add_Click({
    if ($global:lang -eq 'ar') { $global:lang = 'en' } else { $global:lang = 'ar' }
    try { Set-Content -LiteralPath (Join-Path $global:WorkDir 'lang.txt') -Value $global:lang -ErrorAction Stop } catch {}
    Apply-Lang
})

# ==============================================================================
#  Update check (set $global:UpdateUrl at the top of the script to enable)
# ==============================================================================
function Check-UpdateText([string]$text) {
    try {
        $lines = @($text -split "`r?`n" | ForEach-Object { $_.Trim() } | Where-Object { $_ })
        if ($lines.Count -eq 0) { return $null }
        $v = [version]$lines[0].TrimStart('vV')
        if ($v -le [version]$global:Version) { return $null }
        $u = $global:DownloadUrl
        if ($lines.Count -gt 1 -and $lines[1] -match '^https?://') { $u = $lines[1] }
        return @{ Version = $v.ToString(); Url = $u }
    } catch { return $null }
}

function Start-UpdateCheck {
    if (-not $global:UpdateUrl) { return }
    try {
        [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
        $wc = New-Object Net.WebClient
        $wc.Encoding = [Text.Encoding]::UTF8
        $global:updTask = $wc.DownloadStringTaskAsync([uri]$global:UpdateUrl)
        $global:updTicks = 0
        $global:updTimer = New-Object System.Windows.Forms.Timer
        $global:updTimer.Interval = 700
        $global:updTimer.Add_Tick({
            $global:updTicks++
            $t = $global:updTask
            if ($t.IsCompleted -or $global:updTicks -gt 40) {
                $global:updTimer.Stop()
                if ($t.IsCompleted -and -not $t.IsFaulted -and -not $t.IsCanceled) {
                    $r = Check-UpdateText $t.Result
                    if ($r) { $global:updVer = $r.Version; $global:updUrl = $r.Url; Update-Footer }
                }
            }
        })
        $global:updTimer.Start()
    } catch {}
}

